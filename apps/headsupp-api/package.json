{
  "name": "headsupp_app",
  "version": "0.1.0",
  "description": "Heads Up Core API on Cloudflare Workers using vendored CFKit for the control plane",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/**/*.test.js\"",
